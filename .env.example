# =========================================================
# PerguntAI — variáveis de ambiente
# Copie para ".env" e preencha. NUNCA versione o .env no git.
# =========================================================

# ---------- WhatsApp Cloud API (Meta) ----------
# Token de acesso (prefira um System User Token permanente, não o temporário de 24h)
WHATSAPP_TOKEN=
# ID do número de telefone (Painel do app > WhatsApp > Configuração da API)
WHATSAPP_PHONE_NUMBER_ID=
# String que VOCÊ inventa e cola também no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret (Configurações do app > Básico). Usado para validar a assinatura X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Versão da Graph API. v20.0 expirou em 24/09/2026; v26.0 é a mais recente (jul/2026)
GRAPH_API_VERSION=v26.0

# ---------- Adulto Responsável (alerta de risco) ----------
# Formato internacional, só dígitos. Ex: 5521999998888
RESPONSIBLE_ADULT_PHONE=
# Nome/forma de contato do orientador mostrado ao aluno na mensagem de emergência
COUNSELOR_NAME=Orientador(a) da escola
COUNSELOR_CONTACT=procure a coordenação pedagógica
# Template APROVADO pela Meta para o alerta (obrigatório fora da janela de 24h).
# Corpo sugerido do template (categoria UTILITY), com 3 variáveis:
#   "Alerta PerguntAI: possível situação de risco. Aluno: {{1}}. Motivo: {{2}}. Mensagem: {{3}}. Entre em contato com urgência."
ALERT_TEMPLATE_NAME=
ALERT_TEMPLATE_LANG=pt_BR

# ---------- Ambiente de teste ----------
# Lista separada por vírgula. Se preenchida, o bot SÓ responde a esses números.
# Deixe vazia em produção.
TEST_PHONE_NUMBERS=

# ---------- Google Gemini ----------
GEMINI_API_KEY=
# gemini-1.5-flash foi DESLIGADO pelo Google em 29/09/2025 e não responde mais.
# Modelos indicados pelo Google para projetos novos (out/2026): gemini-3.8-flash e gemini-3.5-flash-lite.
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Classificador de risco: priorizamos qualidade (recall) sobre custo. Troque por
# gemini-3.5-flash-lite só depois de medir o desempenho no seu conjunto de testes.
GEMINI_RISK_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RISK_CHECK_TIMEOUT_S=10
ANSWER_TIMEOUT_S=25

# ---------- RAG / ChromaDB ----------
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=perguntai_oficial
RAG_TOP_K=4
# Distância de cosseno máxima aceita (0 = idêntico, 2 = oposto). Calibre com perguntas reais.
RAG_MAX_DISTANCE=0.55

LOG_LEVEL=INFO
